es\": []\n    },\n    {\n      \"entity_type\": \"Preference\",\n      \"natural_key\": \"standing-preference-one-tool-over-three\",\n      \"summary\": \"Has a standing preference for one tool that does a job adequately over three that each do part of it well.\",\n      \"type_confidence\": 0.94,\n      \"considered_types\": []\n    },\n    {\n      \"entity_type\": \"Person\",\n      \"natural_key\": \"wyatt-pemberton\",\n      \"summary\": \"Wyatt Pemberton handles vendor relationships and keeps a spreadsheet of every contract renewal date.\",\n      \"type_confidence\": 0.92,\n      \"considered_types\": []\n    },\n    {\n      \"entity_type\": \"Commitment\",\n      \"natural_key\": \"finance-team-revised-infrastructure-numbers-end-month\",\n      \"summary\": \"Promised the finance team revised infrastructure numbers by the end of the month.\",\n      \"type_confidence\": 0.96,\n      \"considered_types\": []\n    },\n    {\n      \"entity_type\": \"Decision\",\n      \"natural_key\": \"chose-feature-flag-system-over-build\",\n      \"summary\": \"Chose to buy the feature-flag system rather than build one, because the build estimate exceeded three years of licence cost.\",\n      \"type_confidence\": 0.97,\n      \"considered_types\": []\n    },\n    {\n      \"entity_type\": \"Person\",\n      \"natural_key\": \"ilse-castellan\",\n      \"summary\": \"Ilse Castellan is on secondment from the Lisbon office until the end of the year.\",\n      \"type_confidence\": 0.93,\n      \"considered_types\": []\n    },\n    {\n      \"entity_type\": \"Person\",\n      \"natural_key\": \"greta-asplund\",\n      \"summary\": \"Greta Asplund runs user research and has the strongest sense of what people actually do with the product.\",\n      \"type_confidence\": 0.92,\n      \"considered_types\": []\n    },\n    {\n      \"entity_type\": \"Project\",\n      \"natural_key\": \"platform-team-split\",\n      \"summary\": \"The platform team was split into two sub-teams at the