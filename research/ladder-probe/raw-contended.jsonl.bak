_key\":\"blythe-everard\",\"summary\":\"Blythe Everard chairs the architecture forum and insists every proposal names what it rules out.\",\"type_confidence\":1,\"considered_types\":[]},{\"entity_type\":\"Project\",\"natural_key\":\"brightwater\",\"summary\":\"Brightwater is the data quality initiative and has produced more dashboards than fixes so far.\",\"type_confidence\":1,\"considered_types\":[]},{\"entity_type\":\"Person\",\"natural_key\":\"ondine-delacroix\",\"summary\":\"Ondine Delacroix wrote most of the original scheduler and left detailed comments nobody has needed to change.\",\"type_confidence\":1,\"considered_types\":[]},{\"entity_type\":\"Preference\",\"natural_key\":\"prefers-one-tool-over-three-that-each-do-part-of-it-well\",\"summary\":\"Has a standing preference for one tool that does a job adequately over three that each do part of it well.\",\"type_confidence\":1,\"considered_types\":[]},{\"entity_type\":\"Person\",\"natural_key\":\"ilse-castellan\",\"summary\":\"Ilse Castellan is on secondment from the Lisbon office until the end of the year.\",\"type_confidence\":1,\"considered_types\":[]},{\"entity_type\":\"Preference\",\"natural_key\":\"prefers-explicit-error-handling-over-exceptions-propagating-silently\",\"summary\":\"Prefers explicit error handling over exceptions propagating silently up the stack.\",\"type_confidence\":1,\"considered_types\":[]},{\"entity_type\":\"Project\",\"natural_key\":\"marlinspike\",\"summary\":\"Marlinspike is the disaster recovery rehearsal programme, run twice a year.\",\"type_confidence\":1,\"considered_types\":[]},{\"entity_type\":\"Decision\",\"natural_key\":\"chose-weekly-release-train-over-continuous-deployment\",\"summary\":\"Chose a weekly release train over continuous deployment, because the manual verification step could not be removed yet.\",\"type_confidence\":1,\"considered_types\":[]},{\"entity_type\":\"Decision\",\"natural_key\":\"decided-to-keep-new-billing-logic-inside-existing-service\",\"summar